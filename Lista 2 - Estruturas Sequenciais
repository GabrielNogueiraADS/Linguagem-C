/**
#include <stdio.h>

int main()

{
    int votos_candidato1 = 0;
    int votos_candidato2 = 0;
    int votos_candidato3 = 0;
    int votos_nulos = 0;
    int votos_embranco = 0;
    int total = 0;
    float votos_validos = 0;
    float percentual_votosvalidos = 0;
    float percentual_candidato1 = 0;
    float percentual_candidato2 = 0;
    float percentual_candidato3 = 0;
    float percentual_nulos = 0;
    float percentual_embranco = 0;
    
    printf("Digite a quantidade de votos para o candidato 1: \n");
    scanf("%d", &votos_candidato1);
    
    printf("Digite a quantidade de votos para o candidato 2: \n");
    scanf("%d", &votos_candidato2);
    
    printf("Digite a quantidade de votos para o candidato 3: \n");
    scanf("%d", &votos_candidato3);
    
    printf("Digite a quantidade de votos nulos: \n");
    scanf("%d", &votos_nulos);
    
    printf("Digite a quantidade de votos em branco: \n");
    scanf("%d", &votos_embranco);
    
    total = votos_candidato1 + votos_candidato2 + votos_candidato3 + votos_nulos + votos_embranco;
    votos_validos = votos_candidato1 + votos_candidato2 + votos_candidato3;
    percentual_votosvalidos = (total / 100) * votos_validos;
    percentual_candidato1 = (votos_validos / 100) * votos_candidato1;
    percentual_candidato2 = (votos_validos / 100) * votos_candidato2;
    percentual_candidato3 = (votos_validos / 100) * votos_candidato3;
    percentual_nulos = (total / 100) * votos_nulos;
    percentual_embranco = (total / 100) * votos_embranco;
    
    printf("O número total de eleitores é %d \n", total);
    printf("O candidato 1 obteve %.2f por cento dos votos. \n", percentual_candidato1);
    printf("O candidato 2 obteve %.2f por cento dos votos. \n", percentual_candidato2);
    printf("O candidato 3 obteve %.2f por cento dos votos. \n", percentual_candidato3);
    printf("O percentual de votos nulos foi de %.2f por cento. \n", percentual_nulos);
    printf("O percentual de votos em branco foi de %.2f por cento. \n", percentual_embranco);
    
    return 0;
    
}
**/


